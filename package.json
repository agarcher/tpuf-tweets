{
  "name": "tpuf-tweets",
  "version": "1.0.0",
  "description": "A TypeScript CLI tool for ingesting tweets, generating embeddings, and performing hybrid search using turbopuffer",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tpuf-tweets": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "link": "npm link",
    "unlink": "npm unlink",
    "cli": "tsx src/index.ts"
  },
  "keywords": [
    "cli",
    "tweets",
    "search",
    "embeddings",
    "turbopuffer",
    "typescript"
  ],
  "author": "Adam Archer",
  "license": "MIT",
  "dependencies": {
    "@langchain/community": "^0.3.49",
    "@turbopuffer/turbopuffer": "latest",
    "@types/pdf-parse": "^1.1.5",
    "@types/uuid": "^10.0.0",
    "chalk": "latest",
    "cohere-ai": "^7.18.0",
    "commander": "latest",
    "dotenv": "latest",
    "langchain": "^0.3.30",
    "openai": "latest",
    "ora": "latest",
    "pdf-parse": "^1.1.1",
    "uuid": "^11.1.0",
    "voyageai": "^0.0.4"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
